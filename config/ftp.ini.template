[ftp]
# The FTP server starts automatically when enabled is 1.
enabled=1
port=6001

# Anonymous access has full read/write/delete access to the SD card.
anonymous=1
username=
password=

# Close an inactive FTP session after this many seconds. Zero disables the timeout.
timeout=30

# Render file modification times using the console's configured time zone (1) or UTC (0).
# Defaults to 1 when the key is absent.
use_localtime=1
